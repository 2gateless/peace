# Server port
PORT=3000

# Signed session cookie secret (change in production!)
SESSION_SECRET=change-me-to-a-long-random-secret

# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Callback URL (must match Google Cloud Console Authorized redirect URI)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional comma-separated list of Gmail addresses allowed to sign in.
# Leave blank to allow any Google account.
ALLOWED_EMAILS=yourname@gmail.com
