<div class="mb-2">
  <a href="/headache_logs" class="btn btn-ghost btn-sm">← <%= t("nav.back") %></a>
</div>

<div class="max-w-xl mx-auto py-4 space-y-4">
  <% if (attack) { %>
    <div class="card bg-base-100 shadow-md">
      <div class="card-body items-center text-center space-y-4">
        <span class="badge badge-error"><%= t("current_attack.ongoing_heading") %></span>
        <div class="grid grid-flow-col gap-4 text-center auto-cols-max" data-timer data-format="long" data-start="<%= attack.start_time %>">
          <div class="flex flex-col"><span class="countdown font-mono text-3xl"><span data-timer-days style="--value:0;"></span></span><span class="text-xs">d</span></div>
          <div class="flex flex-col"><span class="countdown font-mono text-3xl"><span data-timer-hours style="--value:0;"></span></span><span class="text-xs">h</span></div>
          <div class="flex flex-col"><span class="countdown font-mono text-3xl"><span data-timer-minutes style="--value:0;"></span></span><span class="text-xs">m</span></div>
          <div class="flex flex-col"><span class="countdown font-mono text-3xl"><span data-timer-seconds style="--value:0;"></span></span><span class="text-xs">s</span></div>
        </div>
        <p class="text-xs text-base-content/60"><%= formatTime(attack.start_time) %> · <%= attack.intensity %>/10</p>

        <form method="post" action="/current_attack/end" class="w-full">
          <input type="hidden" name="return_to" value="/headache_logs">
          <button type="submit" class="btn btn-error w-full"><%= t("current_attack.end_btn") %></button>
        </form>

        <% if (medications.length > 0) { %>
          <div class="w-full pt-2 border-t border-base-200">
            <p class="text-xs font-semibold mb-2"><%= t("current_attack.quick_meds") %></p>
            <div class="flex flex-wrap justify-center gap-2">
              <% medications.forEach((med) => { %>
                <form method="post" action="/medication_doses" class="inline">
                  <input type="hidden" name="medication_id" value="<%= med.id %>">
                  <input type="hidden" name="headache_log_id" value="<%= attack.id %>">
                  <input type="hidden" name="return_to" value="/current_attack">
                  <button type="submit" class="btn btn-sm btn-outline gap-2" style="border-color: <%= med.color %>;">
                    <span class="w-2 h-2 rounded-full" style="background-color: <%= med.color %>;"></span>
                    <%= med.name %>
                  </button>
                </form>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="card bg-base-100 shadow-md">
      <div class="card-body space-y-4">
        <div class="text-center">
          <h2 class="text-xl font-bold"><%= t("current_attack.start_heading") %></h2>
          <p class="text-sm text-base-content/60"><%= t("current_attack.start_hint") %></p>
        </div>
        <form method="post" action="/current_attack" class="space-y-4">
          <div data-intensity-slider>
            <div class="flex items-center gap-3">
              <input type="range" name="intensity" min="1" max="10" value="7" class="range range-sm flex-1">
              <div class="radial-progress shadow-sm" style="--size:2.5rem;" data-intensity-badge>
                <span class="text-base font-bold" data-intensity-value>7</span>
              </div>
            </div>
            <div class="mt-2 text-xs text-base-content/60" data-intensity-preview></div>
          </div>
          <button type="submit" class="btn btn-primary w-full"><%= t("current_attack.start_btn") %></button>
        </form>
      </div>
    </div>
  <% } %>
</div>

