<div class="mb-2">
  <a href="/timeline" class="btn btn-ghost btn-sm">← <%= t("nav.back") %></a>
</div>

<div class="card bg-base-100 shadow-md">
  <div class="card-body p-3 sm:p-4">
    <form method="post" action="/medication_doses/<%= dose.id %>" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="bg-base-200/50 rounded-lg p-3">
          <label class="text-sm font-semibold block mb-1"><%= t("nav.medications") %></label>
          <select name="medication_id" class="select select-bordered w-full">
            <% medications.forEach((m) => { %>
              <option value="<%= m.id %>" <%= m.id === dose.medication_id ? "selected" : "" %>><%= m.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="bg-base-200/50 rounded-lg p-3" data-time-picker>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.taken_at") %></label>
          <div class="join w-full">
            <input type="datetime-local" name="taken_at" value="<%= String(dose.taken_at).slice(0, 16) %>" required class="input input-bordered join-item flex-1">
            <button type="button" class="btn join-item" data-time-now><%= t("logs.now") %></button>
          </div>
        </div>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3 grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.amount") %></label>
          <input type="number" name="amount" min="0" step="any" value="<%= dose.amount ?? '' %>" class="input input-bordered w-full">
        </div>
        <div>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.form_unit") %></label>
          <input type="text" name="unit" list="dose_units" value="<%= dose.unit || '' %>" class="input input-bordered w-full">
          <datalist id="dose_units"><% units.forEach((u) => { %><option value="<%= u %>"></option><% }) %></datalist>
        </div>
        <div>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.duration_minutes") %></label>
          <input type="number" name="duration_minutes" min="1" value="<%= dose.duration_minutes ?? '' %>" class="input input-bordered w-full">
        </div>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3 space-y-2">
        <div class="flex flex-wrap gap-2">
          <label class="cursor-pointer"><input type="radio" name="effectiveness" value="" <%= !dose.effectiveness ? "checked" : "" %> class="btn btn-sm" aria-label="<%= t('medications.effectiveness.unrated') %>"></label>
          <% effectivenessOptions.forEach((e) => { %>
            <label class="cursor-pointer"><input type="radio" name="effectiveness" value="<%= e %>" <%= dose.effectiveness === e ? "checked" : "" %> class="btn btn-sm" aria-label="<%= t(`medications.effectiveness.${e}`) %>"></label>
          <% }) %>
        </div>
        <div>
          <label class="text-xs text-base-content/60 block mb-1"><%= t("medications.minutes_to_relief") %></label>
          <input type="number" name="minutes_to_relief" min="0" value="<%= dose.minutes_to_relief ?? '' %>" class="input input-bordered input-sm w-44">
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-full"><%= t("medications.form_save") %></button>
    </form>

    <form method="post" action="/medication_doses/<%= dose.id %>/delete" class="mt-2">
      <button type="submit" class="btn btn-outline btn-error w-full"><%= t("logs.delete") %></button>
    </form>
  </div>
</div>

