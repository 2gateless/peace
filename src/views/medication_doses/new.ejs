<div class="mb-2">
  <a href="/headache_logs" class="btn btn-ghost btn-sm">← <%= t("nav.back") %></a>
</div>

<% if (medications.length > 0) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
    <% medications.forEach((med) => { %>
      <form method="post" action="/medication_doses">
        <input type="hidden" name="medication_id" value="<%= med.id %>">
        <button type="submit" class="card bg-base-100 shadow-md hover:shadow-lg w-full text-left p-4 flex flex-row items-center justify-between">
          <span class="flex items-center gap-2 font-semibold">
            <span class="w-3 h-3 rounded-full" style="background-color: <%= med.color %>;"></span>
            <%= med.name %>
          </span>
          <span class="btn btn-xs btn-primary"><%= t("medications.took_it") %></span>
        </button>
      </form>
    <% }) %>
  </div>
<% } %>

<details class="collapse collapse-arrow bg-base-100 shadow-md" <%= medications.length === 0 ? "open" : "" %>>
  <summary class="collapse-title text-sm font-semibold"><%= t("medications.log_dose") %></summary>
  <div class="collapse-content">
    <form method="post" action="/medication_doses" class="space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="bg-base-200/50 rounded-lg p-3">
          <% if (medications.length > 0) { %>
            <label class="text-sm font-semibold block mb-1"><%= t("nav.medications") %></label>
            <select name="medication_id" class="select select-bordered w-full">
              <% medications.forEach((m) => { %>
                <option value="<%= m.id %>"><%= m.name %></option>
              <% }) %>
            </select>
          <% } else { %>
            <label class="text-sm font-semibold block mb-1"><%= t("medications.form_name") %></label>
            <input type="text" name="medication_name" required class="input input-bordered w-full">
          <% } %>
        </div>
        <div class="bg-base-200/50 rounded-lg p-3" data-time-picker>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.taken_at") %></label>
          <div class="join w-full">
            <input type="datetime-local" name="taken_at" value="<%= nowStr %>" required class="input input-bordered join-item flex-1">
            <button type="button" class="btn join-item" data-time-now><%= t("logs.now") %></button>
          </div>
        </div>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3 grid grid-cols-2 sm:grid-cols-3 gap-3">
        <div>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.amount") %></label>
          <input type="number" name="amount" min="0" step="any" class="input input-bordered w-full">
        </div>
        <div>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.form_unit") %></label>
          <input type="text" name="unit" list="dose_units" class="input input-bordered w-full">
          <datalist id="dose_units"><% units.forEach((u) => { %><option value="<%= u %>"></option><% }) %></datalist>
        </div>
        <div>
          <label class="text-sm font-semibold block mb-1"><%= t("medications.duration_minutes") %></label>
          <input type="number" name="duration_minutes" min="1" class="input input-bordered w-full">
        </div>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3 space-y-2">
        <div class="flex flex-wrap gap-2">
          <label class="cursor-pointer"><input type="radio" name="effectiveness" value="" checked class="btn btn-sm" aria-label="<%= t('medications.effectiveness.unrated') %>"></label>
          <% effectivenessOptions.forEach((e) => { %>
            <label class="cursor-pointer"><input type="radio" name="effectiveness" value="<%= e %>" class="btn btn-sm" aria-label="<%= t(`medications.effectiveness.${e}`) %>"></label>
          <% }) %>
        </div>
        <div>
          <label class="text-xs text-base-content/60 block mb-1"><%= t("medications.minutes_to_relief") %></label>
          <input type="number" name="minutes_to_relief" min="0" class="input input-bordered input-sm w-44">
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-full"><%= t("medications.form_save") %></button>
    </form>
  </div>
</details>

