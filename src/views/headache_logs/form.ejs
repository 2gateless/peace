<div class="mb-2">
  <a href="/headache_logs" class="btn btn-ghost btn-sm">← <%= t("nav.back") %></a>
</div>

<div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200">
  <div class="card-body p-3 sm:p-4">
    <form method="post" action="<%= isEdit ? `/headache_logs/${log.id}` : '/headache_logs' %>" enctype="multipart/form-data" class="space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="bg-base-200/50 rounded-lg p-3" data-time-picker>
          <h3 class="text-sm font-semibold mb-2"><%= t("logs.start_time") %></h3>
          <div class="join w-full">
            <input type="datetime-local" id="headache_log_start_time" name="start_time" value="<%= String(log.start_time || '').slice(0, 16) %>" required class="input input-bordered input-sm join-item flex-1">
            <button type="button" class="btn btn-sm join-item" data-time-now><%= t("logs.now") %></button>
          </div>
          <p class="text-xs text-base-content/60 mt-1 min-h-4" data-time-readout></p>
        </div>

        <div class="bg-base-200/50 rounded-lg p-3" data-time-picker>
          <h3 class="text-sm font-semibold mb-2"><%= t("logs.end_time") %></h3>
          <div class="join w-full">
            <input type="datetime-local" name="end_time" value="<%= log.end_time ? String(log.end_time).slice(0, 16) : '' %>" class="input input-bordered input-sm join-item flex-1">
            <button type="button" class="btn btn-sm join-item" data-time-now><%= t("logs.now") %></button>
          </div>
          <p class="text-xs text-base-content/60 mt-1 min-h-4" data-time-readout></p>
          <span class="badge badge-warning badge-xs mt-2" data-ongoing-badge><%= t("logs.ongoing") %></span>
        </div>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3" data-intensity-slider>
        <h3 class="text-sm font-semibold mb-2"><%= t("logs.intensity") %></h3>
        <div class="flex items-center gap-3">
          <input type="range" name="intensity" min="1" max="10" value="<%= log.intensity || 5 %>" class="range range-sm flex-1">
          <div class="relative">
            <div class="radial-progress shadow-sm" style="--size:2.5rem;" data-intensity-badge>
              <span class="text-base font-bold" data-intensity-value><%= log.intensity || 5 %></span>
            </div>
            <div class="absolute -inset-1 rounded-full opacity-30 blur-sm" data-intensity-glow></div>
          </div>
        </div>
        <div class="mt-2 text-xs text-base-content/60" data-intensity-preview></div>
      </div>

      <div class="bg-primary/5 rounded-lg p-3 space-y-3" data-med-picker data-start-time-field="headache_log_start_time">
        <div class="flex items-center justify-between gap-2">
          <h3 class="text-sm font-semibold"><%= t("medications.doses_title") %></h3>
          <button type="button" class="btn btn-xs btn-ghost" data-med-new-toggle>+ <%= t("medications.new") %></button>
        </div>

        <% if (medications.length > 0) { %>
          <div class="flex flex-wrap gap-1.5">
            <% medications.forEach((med) => { %>
              <button type="button" class="btn btn-xs btn-outline gap-1.5" data-med-add="med_tpl_<%= med.id %>" style="border-color: <%= med.color %>;">
                <span class="w-2 h-2 rounded-full" style="background-color: <%= med.color %>;"></span>
                <%= med.name %>
              </button>
              <template id="med_tpl_<%= med.id %>">
                <div class="bg-base-100 rounded-lg p-2 flex flex-wrap items-center gap-2 shadow-xs" data-dose-row>
                  <input type="hidden" name="dose_id" value="">
                  <input type="hidden" name="dose_destroy" value="0">
                  <input type="hidden" name="dose_medication_id" value="<%= med.id %>">
                  <input type="hidden" name="dose_medication_name" value="">
                  <input type="hidden" name="dose_medication_kind" value="">
                  <span class="text-xs font-semibold" style="color: <%= med.color %>;"><%= med.name %></span>
                  <input type="datetime-local" name="dose_taken_at" class="input input-bordered input-xs">
                  <input type="number" step="any" min="0" name="dose_amount" value="<%= med.default_dose ?? '' %>" placeholder="amount" class="input input-bordered input-xs w-20">
                  <input type="text" name="dose_unit" value="<%= med.unit || '' %>" placeholder="unit" class="input input-bordered input-xs w-16">
                  <input type="number" min="1" name="dose_duration_minutes" placeholder="min" class="input input-bordered input-xs w-16">
                  <button type="button" class="btn btn-ghost btn-xs text-error ml-auto" data-med-remove>✕</button>
                </div>
              </template>
            <% }) %>
          </div>
        <% } %>

        <div class="bg-base-100 rounded-lg p-2 space-y-2" data-med-new-form hidden>
          <div class="flex flex-wrap gap-2">
            <input type="text" placeholder="<%= t('medications.form_name') %>" class="input input-bordered input-xs flex-1" data-med-new-name>
            <button type="button" class="btn btn-xs btn-primary" data-med-new-add><%= t("medications.form_save") %></button>
          </div>
          <div class="flex flex-wrap gap-3 text-xs">
            <% ["abortive", "oxygen", "preventive", "other"].forEach((k) => { %>
              <label class="flex items-center gap-1 cursor-pointer">
                <input type="radio" name="new_med_kind" value="<%= k %>" <%= k === "abortive" ? "checked" : "" %> class="radio radio-xs">
                <span><%= t(`medications.kinds.${k}`) %></span>
              </label>
            <% }) %>
          </div>
        </div>

        <template data-med-new-template>
          <div class="bg-base-100 rounded-lg p-2 flex flex-wrap items-center gap-2 shadow-xs" data-dose-row>
            <input type="hidden" name="dose_id" value="">
            <input type="hidden" name="dose_destroy" value="0">
            <input type="hidden" name="dose_medication_id" value="">
            <input type="hidden" name="dose_medication_name" value="">
            <input type="hidden" name="dose_medication_kind" value="">
            <span class="text-xs font-semibold" data-med-label></span>
            <input type="datetime-local" name="dose_taken_at" class="input input-bordered input-xs">
            <input type="number" step="any" min="0" name="dose_amount" placeholder="amount" class="input input-bordered input-xs w-20">
            <input type="text" name="dose_unit" placeholder="unit" class="input input-bordered input-xs w-16">
            <input type="number" min="1" name="dose_duration_minutes" placeholder="min" class="input input-bordered input-xs w-16">
            <button type="button" class="btn btn-ghost btn-xs text-error ml-auto" data-med-remove>✕</button>
          </div>
        </template>

        <div class="space-y-2" data-med-doses>
          <% (log.doses || []).forEach((d) => { %>
            <div class="bg-base-100 rounded-lg p-2 flex flex-wrap items-center gap-2 shadow-xs" data-dose-row data-persisted="true">
              <input type="hidden" name="dose_id" value="<%= d.id %>">
              <input type="hidden" name="dose_destroy" value="0">
              <input type="hidden" name="dose_medication_id" value="<%= d.medication_id %>">
              <input type="hidden" name="dose_medication_name" value="">
              <input type="hidden" name="dose_medication_kind" value="">
              <span class="text-xs font-semibold" style="color: <%= d.medication_color %>;"><%= d.medication_name %></span>
              <input type="datetime-local" name="dose_taken_at" value="<%= String(d.taken_at).slice(0, 16) %>" class="input input-bordered input-xs">
              <input type="number" step="any" min="0" name="dose_amount" value="<%= d.amount ?? '' %>" class="input input-bordered input-xs w-20">
              <input type="text" name="dose_unit" value="<%= d.unit || '' %>" class="input input-bordered input-xs w-16">
              <input type="number" min="1" name="dose_duration_minutes" value="<%= d.duration_minutes ?? '' %>" class="input input-bordered input-xs w-16">
              <button type="button" class="btn btn-ghost btn-xs text-error ml-auto" data-med-remove>✕</button>
            </div>
          <% }) %>
        </div>
      </div>

      <div class="bg-secondary/5 rounded-lg p-3">
        <h3 class="text-sm font-semibold mb-2"><%= t("logs.triggers") %></h3>
        <span class="text-xs text-base-content/60 mb-2 block"><%= t("logs.triggers_hint") %></span>
        <input type="text" name="triggers" value="<%= log.triggers || '' %>" placeholder="<%= t('logs.triggers_placeholder') %>" list="common-triggers" class="input input-bordered input-sm w-full">
        <datalist id="common-triggers">
          <% t("logs.trigger_suggestions").forEach((s) => { %>
            <option value="<%= s %>"></option>
          <% }) %>
        </datalist>
      </div>

      <div class="bg-info/5 rounded-lg p-3">
        <h3 class="text-sm font-semibold mb-2"><%= t("logs.pressure") %></h3>
        <span class="text-xs text-base-content/60 mb-2 block"><%= t("logs.pressure_hint") %></span>
        <input type="number" name="barometric_pressure" min="870" max="1085" step="0.1" value="<%= log.barometric_pressure ?? '' %>" placeholder="<%= t('logs.pressure_placeholder') %>" class="input input-bordered input-sm w-full">
      </div>

      <div class="bg-base-200 rounded-lg p-3">
        <h3 class="text-sm font-semibold mb-2"><%= t("logs.notes") %></h3>
        <textarea name="notes" rows="3" placeholder="<%= t('logs.notes_placeholder') %>" class="textarea textarea-bordered textarea-sm w-full"><%= log.notes || '' %></textarea>
      </div>

      <div class="bg-base-200/50 rounded-lg p-3">
        <h3 class="text-sm font-semibold mb-1"><%= t("logs.photos") %></h3>
        <p class="text-xs text-base-content/60 mb-2"><%= t("logs.photos_hint") %></p>
        <input type="file" name="photos" accept="image/*" multiple class="file-input file-input-bordered file-input-sm w-full">
      </div>

      <button type="submit" class="btn btn-primary w-full mt-4"><%= isEdit ? t("logs.update_btn") : t("logs.create_btn") %></button>
    </form>

    <% if (isEdit) { %>
      <form method="post" action="/headache_logs/<%= log.id %>/delete" class="mt-2" data-confirm="<%= t('logs.delete_confirm') %>">
        <button type="submit" class="btn btn-outline btn-error w-full"><%= t("logs.delete") %></button>
      </form>
    <% } %>
  </div>
</div>

