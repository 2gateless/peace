<div class="flex justify-end gap-2 mb-4 print:hidden">
  <button type="button" onclick="window.print()" class="btn btn-primary btn-sm"><%= t("logs.print") %></button>
  <button type="button" onclick="pdf_report_modal.showModal()" class="btn btn-outline btn-sm"><%= t("logs.download_pdf") %></button>
</div>

<%- include("../partials/pdf_modal") %>

<div class="mb-6">
  <h1 class="text-3xl font-bold mb-1"><%= t("app.title") %> — <%= currentUser.name || currentUser.email %></h1>
  <p class="text-sm text-base-content/60"><%= new Date().toISOString().slice(0, 10) %></p>
</div>

<div class="print:hidden join join-vertical w-full mb-4">
  <%- include("../partials/filter_form", { actionUrl: "/headache_log_print" }) %>
</div>

<%- include("../partials/stats") %>
<%- include("../partials/charts_body") %>

<h2 class="text-2xl font-bold mb-3 mt-8"><%= t("logs.title") %></h2>
<div class="overflow-x-auto bg-base-100 rounded-lg shadow">
  <table class="table table-sm">
    <thead>
      <tr>
        <th><%= t("logs.start_time") %></th>
        <th><%= t("logs.intensity") %></th>
        <th><%= t("nav.medications") %></th>
        <th><%= t("logs.triggers") %></th>
        <th><%= t("logs.notes") %></th>
      </tr>
    </thead>
    <tbody>
      <% logs.forEach((l) => { %>
        <tr>
          <td class="whitespace-nowrap"><%= formatTime(l.start_time) %></td>
          <td class="font-bold" style="color: <%= intensityColor(l.intensity) %>;"><%= l.intensity %>/10</td>
          <td><%= l.medication || "—" %></td>
          <td><%= l.triggers || "—" %></td>
          <td><%= l.notes || "—" %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

