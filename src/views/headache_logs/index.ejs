<% awaitingReview.forEach((reviewLog) => { %>
  <div class="card bg-base-100 shadow-md border border-primary/20 mb-4">
    <div class="card-body p-3 sm:p-4">
      <h3 class="text-sm font-semibold"><%= t("logs.dose_review_title") %> <span class="text-xs font-normal text-base-content/60">(<%= formatTime(reviewLog.start_time) %>)</span></h3>
      <div class="space-y-2 mt-2">
        <% reviewLog.unrated_doses.forEach((dose) => { %>
          <div class="flex flex-wrap items-center justify-between gap-2 bg-base-200/50 rounded-lg p-2">
            <span class="text-sm font-medium"><%= dose.medication_name %></span>
            <div class="flex flex-wrap gap-1">
              <% ["helped", "no_effect", "made_worse"].forEach((eff) => { %>
                <form method="post" action="/medication_doses/<%= dose.id %>" class="inline">
                  <input type="hidden" name="effectiveness" value="<%= eff %>">
                  <input type="hidden" name="return_to" value="/headache_logs">
                  <button type="submit" class="btn btn-xs btn-outline"><%= t(`medications.effectiveness.${eff}`) %></button>
                </form>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
<% }) %>

<% if (dueMedications && dueMedications.length > 0) { %>
  <div class="card bg-base-100 shadow-md mb-4">
    <div class="card-body p-3 sm:p-4 flex flex-row flex-wrap items-center justify-between gap-2">
      <span class="text-sm font-semibold"><%= t("medications.log_dose") %></span>
      <div class="flex flex-wrap gap-2">
        <% dueMedications.forEach((med) => { %>
          <form method="post" action="/medication_doses" class="inline">
            <input type="hidden" name="medication_id" value="<%= med.id %>">
            <input type="hidden" name="return_to" value="/headache_logs">
            <button type="submit" class="btn btn-sm btn-outline gap-2" style="border-color: <%= med.color %>;">
              <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= med.color %>;"></span>
              <%= med.name %>
            </button>
          </form>
        <% }) %>
      </div>
    </div>
  </div>
<% } %>

<%- include("../partials/medication_nav") %>

<div class="flex flex-wrap items-center justify-end gap-2 mb-4 print:hidden" id="report_actions">
  <a href="/headache_log_print" class="btn btn-outline btn-sm"><%= t("logs.print") %></a>
  <button type="button" class="btn btn-outline btn-sm" onclick="pdf_report_modal.showModal()"><%= t("logs.download_pdf") %></button>
</div>

<%- include("../partials/pdf_modal") %>

<div class="join join-vertical w-full mb-4">
  <%- include("../partials/filter_form", { actionUrl: "/headache_logs" }) %>
</div>

<%- include("../partials/stats") %>

<% if (logs.length === 0) { %>
  <div class="text-center py-12">
    <div class="max-w-md mx-auto">
      <% if (filters.start_time || filters.end_time || filters.triggers || filters.medication) { %>
        <p class="text-xl text-base-content/60 mb-4"><%= t("logs.no_matches") %></p>
        <a href="/headache_logs" class="btn btn-primary"><%= t("logs.clear_filters") %></a>
      <% } else { %>
        <p class="text-xl text-base-content/60 mb-4"><%= t("logs.empty") %></p>
        <p class="text-base-content/60 mb-6"><%= t("logs.empty_hint") %></p>
        <a href="/headache_logs/new" class="btn btn-primary"><%= t("logs.new") %></a>
      <% } %>
    </div>
  </div>
<% } else { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4">
    <% logs.forEach((log) => { %>
      <%- include("../partials/headache_card", { log, hideActions: false }) %>
    <% }) %>
  </div>
<% } %>

