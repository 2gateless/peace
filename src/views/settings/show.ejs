<!-- Language and Time Section -->
<div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 mb-4" id="preferences">
  <div class="card-body p-3 sm:p-4">
    <h2 class="text-sm sm:text-base font-semibold mb-3"><%= t("settings.preferences_title") %></h2>
    <form method="post" action="/settings/preferences" class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <div class="bg-base-200/50 rounded-lg p-3">
        <label class="text-sm font-semibold mb-2 block"><%= t("settings.language") %></label>
        <select name="locale" class="select select-bordered w-full">
          <option value="" <%= !currentUser.locale ? "selected" : "" %>><%= t("settings.automatic_language") %></option>
          <% AVAILABLE_LOCALES.forEach((loc) => { %>
            <option value="<%= loc %>" <%= currentUser.locale === loc ? "selected" : "" %>><%= t(`languages.${loc}`) %></option>
          <% }) %>
        </select>
      </div>

      <fieldset class="bg-base-200/50 rounded-lg p-3">
        <legend class="text-sm font-semibold mb-2"><%= t("settings.time_format") %></legend>
        <div class="flex flex-col gap-1">
          <label class="label cursor-pointer justify-start gap-3 py-1">
            <input type="radio" name="time_format" value="" <%= !currentUser.time_format ? "checked" : "" %> class="radio radio-sm">
            <span><%= t("settings.automatic_time") %></span>
          </label>
          <label class="label cursor-pointer justify-start gap-3 py-1">
            <input type="radio" name="time_format" value="12h" <%= currentUser.time_format === "12h" ? "checked" : "" %> class="radio radio-sm">
            <span><%= t("settings.twelve_hour") %></span>
          </label>
          <label class="label cursor-pointer justify-start gap-3 py-1">
            <input type="radio" name="time_format" value="24h" <%= currentUser.time_format === "24h" ? "checked" : "" %> class="radio radio-sm">
            <span><%= t("settings.twenty_four_hour") %></span>
          </label>
        </div>
      </fieldset>

      <div class="md:col-span-2">
        <button type="submit" class="btn btn-primary btn-sm w-full md:w-auto"><%= t("settings.save") %></button>
      </div>
    </form>
  </div>
</div>

<!-- Data Management Section -->
<div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 mb-4">
  <div class="card-body p-3 sm:p-4">
    <h2 class="text-sm sm:text-base font-semibold mb-3"><%= t("settings.data_title") %></h2>
    <div class="flex flex-col sm:flex-row gap-2">
      <button type="button" onclick="import_modal.showModal()" class="btn btn-outline btn-sm"><%= t("settings.import_csv") %></button>
      <a href="/headache_log_export.csv" class="btn btn-primary btn-sm"><%= t("settings.export_logs_csv") %></a>
      <a href="/medication_dose_export.csv" class="btn btn-outline btn-sm"><%= t("settings.export_doses_csv") %></a>
    </div>
  </div>
</div>

<!-- Google Account Section -->
<div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 mb-4">
  <div class="card-body p-3 sm:p-4">
    <h2 class="text-sm sm:text-base font-semibold mb-3"><%= t("settings.account_title") %></h2>
    <div class="flex items-center justify-between gap-3 bg-base-200/50 rounded-lg p-3">
      <div class="flex items-center gap-3 min-w-0">
        <% if (currentUser.avatar_url) { %>
          <img src="<%= currentUser.avatar_url %>" alt="" class="w-10 h-10 rounded-full shrink-0" referrerpolicy="no-referrer">
        <% } %>
        <div class="min-w-0">
          <p class="text-sm font-semibold truncate"><%= currentUser.name || currentUser.username %></p>
          <p class="text-xs text-base-content/60 truncate"><%= currentUser.email %></p>
        </div>
      </div>
      <form method="post" action="/users/sign_out">
        <button type="submit" class="btn btn-outline btn-sm shrink-0"><%= t("nav.sign_out") %></button>
      </form>
    </div>
  </div>
</div>

<!-- Delete Account Section -->
<div class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-200 mb-4" id="delete_account">
  <div class="card-body p-3 sm:p-4">
    <h2 class="text-sm sm:text-base font-semibold text-error mb-2"><%= t("settings.delete_title") %></h2>
    <p class="text-xs text-base-content/70 mb-3"><%= t("settings.delete_hint") %></p>
    <form method="post" action="/settings/account/delete" data-confirm="<%= t('settings.delete_confirm') %>">
      <button type="submit" class="btn btn-outline btn-error btn-sm w-full sm:w-auto"><%= t("settings.delete_btn") %></button>
    </form>
  </div>
</div>

<!-- Import Modal -->
<dialog id="import_modal" class="modal">
  <div class="modal-box">
    <h3 class="text-base font-semibold mb-3"><%= t("settings.import_modal_title") %></h3>
    <p class="text-xs text-base-content/70 mb-3"><%= t("settings.import_hint") %></p>
    <div class="bg-base-300 p-2 rounded text-xs font-mono mb-4">start_time, end_time, intensity, medication, triggers, notes</div>
    <form method="post" action="/headache_log_import" enctype="multipart/form-data">
      <input type="file" name="file" accept=".csv" required class="file-input file-input-bordered file-input-sm w-full">
      <div class="modal-action">
        <button type="button" class="btn btn-ghost btn-sm" onclick="import_modal.close()"><%= t("pdf.cancel") %></button>
        <button type="submit" class="btn btn-primary btn-sm"><%= t("settings.import_submit") %></button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

