<div class="flex items-center justify-between mb-3">
  <a href="/headache_logs" class="btn btn-ghost btn-sm">← <%= t("nav.back") %></a>
  <a href="/medication_doses/new" class="btn btn-primary btn-sm">+ <%= t("medications.log_dose") %></a>
</div>

<% if (timeline.entries.length > 0) { %>
  <ol class="space-y-6" id="timeline">
    <% timeline.days.forEach((day) => { %>
      <li>
        <h2 class="text-sm font-semibold text-base-content/70 mb-2 sticky top-16 z-10 bg-base-200/90 backdrop-blur py-1">
          <%= formatTime(day.date, "date") %>
        </h2>
        <ol class="border-l-2 border-base-300 ml-2 space-y-3">
          <% day.entries.forEach((entry) => { %>
            <li class="relative pl-5">
              <% if (entry.type === "attack") { %>
                <div class="card bg-base-100 shadow-sm">
                  <div class="card-body p-3 flex flex-row items-center justify-between">
                    <div>
                      <a href="/headache_logs/<%= entry.item.id %>" class="font-semibold text-sm hover:underline">
                        <%= formatTime(entry.item.start_time, "time") %> · <%= t("logs.intensity") %> <%= entry.item.intensity %>/10
                      </a>
                      <% if (entry.item.notes) { %>
                        <p class="text-xs text-base-content/60"><%= entry.item.notes %></p>
                      <% } %>
                    </div>
                    <span class="badge badge-sm" style="background-color: <%= intensityColor(entry.item.intensity) %>; color: #fff;"><%= entry.item.intensity %></span>
                  </div>
                </div>
              <% } else { %>
                <div class="card bg-base-100 shadow-sm">
                  <div class="card-body p-3 flex flex-row items-center justify-between">
                    <div>
                      <span class="text-sm font-medium"><%= formatTime(entry.item.taken_at, "time") %> · <%= entry.item.medication_name %></span>
                      <% if (entry.item.amount !== null && entry.item.amount !== undefined) { %>
                        <span class="text-xs text-base-content/60 ml-1"><%= formatAmount(entry.item.amount) %> <%= entry.item.unit || "" %></span>
                      <% } %>
                    </div>
                    <a href="/medication_doses/<%= entry.item.id %>/edit" class="btn btn-ghost btn-xs"><%= t("medications.edit") %></a>
                  </div>
                </div>
              <% } %>
            </li>
          <% }) %>
        </ol>
      </li>
    <% }) %>
  </ol>
  <% if (timeline.nextBefore) { %>
    <div class="text-center mt-6">
      <a href="/timeline?before=<%= encodeURIComponent(timeline.nextBefore) %>" class="btn btn-outline btn-sm">...</a>
    </div>
  <% } %>
<% } else { %>
  <div class="card bg-base-100 shadow-md">
    <div class="card-body items-center text-center">
      <p class="text-base-content/70"><%= t("medications.timeline_empty") %></p>
    </div>
  </div>
<% } %>

