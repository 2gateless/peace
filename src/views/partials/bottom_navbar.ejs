    <span class="dock-label text-xs mt-1"><%= t("nav.charts") %></span>
  </a>

  <a href="/headache_logs/new" class="transition-all duration-200 <%= currentPath === '/headache_logs/new' ? 'dock-active text-primary' : 'hover:text-primary' %>">
