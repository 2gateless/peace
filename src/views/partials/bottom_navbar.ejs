      <div class="absolute w-12 h-12 sm:w-14 sm:h-14 bg-primary rounded-full opacity-40 blur-md"></div>
      <svg class="size-7 sm:size-8 relative z-10" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25ZM12.75 9a.75.75 0 0 0-1.5 0v2.25H9a.75.75 0 0 0 0 1.5h2.25V15a.75.75 0 0 0 1.5 0v-2.25H15a.75.75 0 0 0 0-1.5h-2.25V9Z" clip-rule="evenodd"/></svg>
    </div>
    <span class="dock-label text-xs mt-1"><%= t("nav.new") %></span>
  </a>

  <a href="/settings" class="transition-all duration-200 <%= currentPath === '/settings' ? 'dock-active text-accent' : 'hover:text-accent' %>">
    <svg class="size-5 sm:size-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>
    <span class="dock-label text-xs mt-1"><%= t("nav.account") %></span>
