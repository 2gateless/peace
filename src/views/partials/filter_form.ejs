<% const activeCount = [filters.start_time, filters.end_time, filters.triggers, filters.medication].filter(Boolean).length; %>
<details class="collapse bg-base-100 collapse-arrow shadow join-item print:hidden" <%= activeCount > 0 ? "open" : "" %>>
  <summary class="collapse-title text-sm sm:text-base font-medium py-3 sm:py-4">
    <svg class="w-5 h-5 mr-2 inline-block" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"/></svg>
    <%= t("filters.title") %>
    <% if (activeCount > 0) { %>
      <span class="badge badge-primary badge-sm ml-2"><%= t("filters.active", { count: activeCount }) %></span>
    <% } %>
  </summary>
  <div class="collapse-content pt-2">
    <form method="get" action="<%= actionUrl || currentPath %>">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
        <div class="bg-base-200/50 rounded-lg p-3">
          <h3 class="text-sm font-semibold mb-2"><%= t("filters.date_range") %></h3>
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label class="text-xs text-base-content/60 mb-1 block"><%= t("filters.start") %></label>
              <input type="date" name="start_time" value="<%= filters.start_time || '' %>" class="input input-bordered input-sm w-full">
            </div>
            <div>
              <label class="text-xs text-base-content/60 mb-1 block"><%= t("filters.end") %></label>
              <input type="date" name="end_time" value="<%= filters.end_time || '' %>" class="input input-bordered input-sm w-full">
            </div>
          </div>
        </div>
        <div class="bg-base-200/50 rounded-lg p-3">
          <h3 class="text-sm font-semibold mb-2"><%= t("filters.keywords") %></h3>
          <div class="space-y-2">
            <div>
              <label class="text-xs text-base-content/60 mb-1 block"><%= t("filters.triggers") %></label>
              <input type="text" name="triggers" value="<%= filters.triggers || '' %>" class="input input-bordered input-sm w-full">
            </div>
            <div>
              <label class="text-xs text-base-content/60 mb-1 block"><%= t("filters.medication") %></label>
              <input type="text" name="medication" value="<%= filters.medication || '' %>" list="filter_medications" class="input input-bordered input-sm w-full">
              <datalist id="filter_medications">
                <% (medications || []).forEach((m) => { %>
                  <option value="<%= m.name %>"></option>
                <% }) %>
              </datalist>
            </div>
          </div>
        </div>
      </div>
      <div class="flex items-center justify-between gap-2">
        <a href="<%= actionUrl || currentPath %>" class="btn btn-ghost btn-sm"><%= t("filters.clear") %></a>
        <button type="submit" class="btn btn-primary btn-sm"><%= t("filters.apply") %></button>
      </div>
    </form>
  </div>
</details>

