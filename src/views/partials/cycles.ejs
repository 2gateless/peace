<section id="cycles" class="mb-8 print:mb-6">
  <h2 class="text-xl sm:text-2xl font-bold mb-1"><%= t("charts.cycles_title") %></h2>
  <p class="text-sm text-base-content/70 mb-4 print:text-black"><%= t("charts.cycles_rule", { count: cycles.remission_threshold }) %></p>

  <div class="stats stats-vertical md:stats-horizontal print:stats-horizontal shadow print:shadow-none mb-4 bg-base-100 w-full [&_.stat]:py-3 [&_.stat]:px-4">
    <div class="stat">
      <div class="stat-title text-xs sm:text-sm"><%= t("charts.cycle_count") %></div>
      <div class="stat-value text-lg sm:text-2xl"><%= cycles.cycles.length %></div>
      <div class="stat-desc">
        <% if (cycles.current_cycle) { %>
          <%= t("charts.current_cycle_since", { date: formatTime(cycles.current_cycle.start_on, "date") }) %>
        <% } else { %>
          <%= t("charts.not_in_cycle") %>
        <% } %>
      </div>
    </div>

    <div class="stat">
      <div class="stat-title text-xs sm:text-sm"><%= t("charts.avg_cycle_length") %></div>
      <div class="stat-value text-lg sm:text-2xl"><%= cycles.average_cycle_length ? t("charts.days", { count: cycles.average_cycle_length }) : "—" %></div>
    </div>

    <div class="stat">
      <div class="stat-title text-xs sm:text-sm"><%= t("charts.avg_remission_length") %></div>
      <div class="stat-value text-lg sm:text-2xl"><%= cycles.average_remission_length ? t("charts.days", { count: cycles.average_remission_length }) : "—" %></div>
      <div class="stat-desc"><%= cycles.cycles.length < 2 ? t("charts.needs_two_cycles") : "" %></div>
    </div>
  </div>

  <div class="card bg-base-100 shadow-md print:shadow-none mb-4">
    <div class="card-body p-3 sm:p-4">
      <h3 class="text-sm sm:text-base font-semibold"><%= t("charts.heatmap_title") %></h3>
      <div class="overflow-x-auto" dir="rtl">
        <div id="attack_calendar" dir="ltr" class="inline-flex gap-[3px] py-1 [print-color-adjust:exact]">
          <% cycles.weeks.forEach((week) => { %>
            <div class="flex flex-col gap-[3px]">
              <% week.forEach((day) => { %>
                <% if (day) { %>
                  <% const cnt = cycles.attack_counts_by_day[day] || 0; %>
                  <div class="size-3 rounded-sm <%= heatmapCellClass(cnt) %>" title="<%= day %>: <%= cnt %>"></div>
                <% } else { %>
                  <div class="size-3"></div>
                <% } %>
              <% }) %>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="flex items-center justify-end gap-1 text-xs text-base-content/60 [print-color-adjust:exact]">
        <span class="mr-1"><%= t("charts.fewer") %></span>
        <% [0, 1, 2, 3, 5].forEach((c) => { %>
          <span class="size-3 rounded-sm <%= heatmapCellClass(c) %>"></span>
        <% }) %>
        <span class="ml-1"><%= t("charts.more") %></span>
      </div>
    </div>
  </div>

  <% if (cycles.cycles.length > 0) { %>
    <div class="card bg-base-100 shadow-md print:shadow-none">
      <div class="card-body p-3 sm:p-4">
        <h3 class="text-sm sm:text-base font-semibold"><%= t("charts.cycle_table_title") %></h3>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th><%= t("charts.cycle_start") %></th>
                <th><%= t("charts.cycle_end") %></th>
                <th class="text-right"><%= t("charts.cycle_length") %></th>
                <th class="text-right"><%= t("charts.cycle_attacks") %></th>
                <th class="text-right"><%= t("charts.cycle_avg_intensity") %></th>
                <th><%= t("charts.cycle_since_prev") %></th>
              </tr>
            </thead>
            <tbody>
              <% for (let i = cycles.cycles.length - 1; i >= 0; i--) { %>
                <% const cycle = cycles.cycles[i]; const rem = i > 0 ? cycles.remissions[i - 1] : null; %>
                <tr>
                  <td class="whitespace-nowrap"><%= formatTime(cycle.start_on, "date") %></td>
                  <td class="whitespace-nowrap">
                    <% if (cycle.ongoing) { %>
                      <span class="badge badge-sm badge-error badge-soft"><%= t("charts.cycle_ongoing") %></span>
                    <% } else { %>
                      <%= formatTime(cycle.end_on, "date") %>
                    <% } %>
                  </td>
                  <td class="text-right whitespace-nowrap"><%= t("charts.days", { count: cycle.length_in_days }) %></td>
                  <td class="text-right"><%= cycle.attack_count %></td>
                  <td class="text-right">
                    <% if (cycle.average_intensity) { %>
                      <span class="font-semibold" style="color: <%= intensityColor(cycle.average_intensity) %>;"><%= cycle.average_intensity %></span>
                    <% } else { %>—<% } %>
                  </td>
                  <td class="whitespace-nowrap">
                    <% if (rem) { %>
                      <%= t("charts.days", { count: rem.length_in_days }) %>
                      <% if (rem.ichd_remission) { %>
                        <span class="badge badge-sm badge-success badge-soft"><%= t("charts.ichd_remission") %></span>
                      <% } %>
                    <% } else { %>—<% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</section>

