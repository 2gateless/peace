<dialog id="pdf_report_modal" class="modal modal-bottom sm:modal-middle print:hidden">
  <div class="modal-box">
    <h3 class="text-lg font-bold"><%= t("pdf.modal_title") %></h3>
    <form method="get" action="/headache_log_print.pdf" onsubmit="this.closest('dialog').close()" class="space-y-3 mt-3">
      <% ["start_time", "end_time", "triggers", "medication"].forEach((key) => { %>
        <% if (filters && filters[key]) { %>
          <input type="hidden" name="<%= key %>" value="<%= filters[key] %>">
        <% } %>
      <% }) %>
      <div>
        <label class="text-sm font-medium mb-1 block"><%= t("pdf.patient_name") %></label>
        <input type="text" name="patient_name" maxlength="100" class="input input-bordered w-full">
      </div>
      <div>
        <label class="text-sm font-medium mb-1 block"><%= t("pdf.prepared_for") %></label>
        <input type="text" name="prepared_for" maxlength="100" class="input input-bordered w-full">
      </div>
      <div class="modal-action">
        <button type="button" class="btn btn-ghost" onclick="pdf_report_modal.close()"><%= t("pdf.cancel") %></button>
        <button type="submit" class="btn btn-primary"><%= t("pdf.download") %></button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button><%= t("pdf.cancel") %></button></form>
</dialog>

