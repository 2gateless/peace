<% if (insights && insights.summaries && insights.summaries.length > 0) { %>
  <section class="mb-8">
    <h2 class="text-xl font-bold mb-3"><%= t("medications.insights_title") %></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
      <% insights.summaries.forEach((s) => { %>
        <div class="card bg-base-100 shadow-md">
          <div class="card-body p-3 sm:p-4">
            <div class="flex items-center justify-between gap-2">
              <span class="badge gap-2 font-semibold" style="border-color: <%= s.medication.color %>;">
                <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= s.medication.color %>;"></span>
                <%= s.medication.name %>
              </span>
              <span class="text-xs text-base-content/60"><%= s.doses_count %> doses</span>
            </div>
            <dl class="grid grid-cols-3 gap-2 text-sm mt-2">
              <div>
                <dt class="text-xs text-base-content/60"><%= t("medications.success_rate") %></dt>
                <dd class="font-semibold"><%= s.success_rate !== null ? `${s.success_rate}%` : "—" %></dd>
              </div>
              <div>
                <dt class="text-xs text-base-content/60"><%= t("medications.avg_relief") %></dt>
                <dd class="font-semibold"><%= s.average_minutes_to_relief !== null ? `${s.average_minutes_to_relief} min` : "—" %></dd>
              </div>
              <div>
                <dt class="text-xs text-base-content/60"><%= t("medications.adherence") %></dt>
                <dd class="font-semibold"><%= s.adherence !== null ? `${s.adherence}%` : "—" %></dd>
              </div>
            </dl>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
<% } %>

