<div class="flex items-center justify-between mb-3">
  <a href="/headache_logs" class="btn btn-ghost btn-sm">← <%= t("nav.back") %></a>
  <a href="/medications/new" class="btn btn-primary btn-sm">+ <%= t("medications.new") %></a>
</div>

<% if (medications.length > 0) { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <% medications.forEach((med) => { %>
      <div class="card bg-base-100 shadow-md">
        <div class="card-body p-3 sm:p-4 flex flex-row items-center justify-between gap-3">
          <a href="/medications/<%= med.id %>" class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full shrink-0" style="background-color: <%= med.color %>;"></span>
              <span class="font-semibold truncate"><%= med.name %></span>
              <span class="badge badge-ghost badge-xs"><%= t(`medications.kinds.${med.kind}`) %></span>
            </div>
            <p class="text-xs text-base-content/60 mt-1">
              <%= t(`medications.frequencies.${med.frequency}`) %>
              <% if (med.default_dose !== null && med.default_dose !== undefined) { %>
                · <%= formatAmount(med.default_dose) %> <%= med.unit || "" %>
              <% } %>
            </p>
          </a>
          <form method="post" action="/medication_doses" class="shrink-0">
            <input type="hidden" name="medication_id" value="<%= med.id %>">
            <input type="hidden" name="return_to" value="/medications">
            <button type="submit" class="btn btn-sm btn-outline"><%= t("medications.took_it") %></button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } else { %>
  <div class="card bg-base-100 shadow-md">
    <div class="card-body items-center text-center">
      <p class="text-base-content/70"><%= t("medications.empty") %></p>
      <a href="/medications/new" class="btn btn-primary"><%= t("medications.new") %></a>
    </div>
  </div>
<% } %>

<% if (archivedMedications.length > 0) { %>
  <details class="collapse collapse-arrow bg-base-100 shadow mt-6">
    <summary class="collapse-title text-sm font-medium"><%= t("medications.archived_section", { count: archivedMedications.length }) %></summary>
    <div class="collapse-content flex flex-wrap gap-2">
      <% archivedMedications.forEach((med) => { %>
        <a href="/medications/<%= med.id %>" class="badge badge-outline gap-1.5">
          <span class="w-2 h-2 rounded-full" style="background-color: <%= med.color %>;"></span>
          <%= med.name %>
        </a>
      <% }) %>
    </div>
  </details>
<% } %>

